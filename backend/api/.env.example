# Copy to .env. Local development values only — never use these in production.

# Runtime connection: non-superuser role, so Row Level Security is enforced.
DATABASE_URL=postgresql://xeva_app:xeva_app_dev@localhost:5433/xeva
# Migrations and seeding: schema owner.
MIGRATION_DATABASE_URL=postgresql://xeva_owner:xeva_owner_dev@localhost:5433/xeva

JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600
PORT=4000

# Outbox dispatcher poll interval (ms). Set to 0 to disable the background worker.
OUTBOX_POLL_MS=1000
